#!/bin/bash
#
# hermes-omarchy-scene — lower-third overlay for camera demos
#
#   install | remove | check
#   show [--kicker TEXT] [--subtitle TEXT] [--duration MS] <title>
#   hide
#
# Overlay plugin smf.scene-card. Not a bar widget.
# Click the card, Escape, or Super+W to dismiss (Super+W does not close Hermes).

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
SRC="$REPO_ROOT/overlay-plugin"
SRC_LUA="$REPO_ROOT/hypr/hermes-scene.lua"
DEST="$HOME/.config/omarchy/plugins/smf.scene-card"
DEST_LUA="$HOME/.config/hypr/hermes-scene.lua"
HYPRLAND_LUA="$HOME/.config/hypr/hyprland.lua"
REQUIRE='require("hypr.hermes-scene")'
ID="smf.scene-card"

ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1" >&2; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$1" >&2; }

usage() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

install_plugin() {
  [[ -f $SRC/manifest.json && -f $SRC/SceneCard.qml ]] || { fail "overlay source missing: $SRC"; return 1; }
  mkdir -p "$DEST"
  cp -a "$SRC/manifest.json" "$SRC/SceneCard.qml" "$DEST/"
  if ! omarchy plugin validate "$DEST"; then
    fail "smf.scene-card failed omarchy plugin validate"
    return 1
  fi
  ok "copied $DEST"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  if omarchy plugin enable "$ID"; then
    ok "enabled $ID"
  else
    warn "copied but not enabled (run: omarchy plugin enable $ID)"
  fi
  if [[ -f $SRC_LUA ]]; then
    mkdir -p "$(dirname "$DEST_LUA")"
    cp -f "$SRC_LUA" "$DEST_LUA"
    ok "wrote $DEST_LUA"
    if [[ -f $HYPRLAND_LUA ]] && ! grep -qF -- "$REQUIRE" "$HYPRLAND_LUA"; then
      if grep -q 'require("hypr.hermes-exclusive")' "$HYPRLAND_LUA"; then
        local tmp
        tmp="$(mktemp)"
        awk -v line="$REQUIRE" '
          { print }
          $0 ~ /require\("hypr.hermes-exclusive"\)/ && !seen { print line; seen=1 }
        ' "$HYPRLAND_LUA" >"$tmp"
        mv "$tmp" "$HYPRLAND_LUA"
      else
        printf '\n%s\n' "$REQUIRE" >>"$HYPRLAND_LUA"
      fi
      ok "added $REQUIRE"
    fi
    hyprctl reload >/dev/null 2>&1 || true
  fi
}

remove_plugin() {
  omarchy plugin disable "$ID" >/dev/null 2>&1 || true
  omarchy-shell -q shell hide "$ID" >/dev/null 2>&1 || true
  if [[ -f $HYPRLAND_LUA ]] && grep -qF -- "$REQUIRE" "$HYPRLAND_LUA"; then
    local tmp
    tmp="$(mktemp)"
    grep -vF -- "$REQUIRE" "$HYPRLAND_LUA" >"$tmp" || true
    mv "$tmp" "$HYPRLAND_LUA"
    ok "removed require from $HYPRLAND_LUA"
  fi
  rm -f "$DEST_LUA"
  if [[ -d $DEST && ! -L $DEST ]]; then
    rm -rf "$DEST"
    ok "removed $DEST"
  else
    ok "plugin dir not installed"
  fi
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
}

check_plugin() {
  local rc=0
  if [[ ! -f $DEST/manifest.json ]]; then
    fail "not installed: $DEST"
    return 1
  fi
  if ! omarchy plugin validate "$DEST" >/dev/null; then
    fail "validate failed"
    rc=1
  else
    ok "validate ok"
  fi
  if omarchy-shell shell listPlugins 2>/dev/null | python3 -c "
import json,sys
raw=sys.stdin.read()
try:
    data=json.loads(raw)
except Exception:
    sys.exit(2)
found=next((p for p in data if p.get('id')=='smf.scene-card'), None)
sys.exit(0 if found and found.get('enabled') else 1)
"; then
    ok "enabled in omarchy-shell"
  else
    fail "not enabled in omarchy-shell"
    rc=1
  fi
  return "$rc"
}

show_card() {
  local kicker="HERMES"
  local subtitle=""
  local duration="5000"
  local extras=()
  while (( $# > 0 )); do
    case "$1" in
      --kicker) kicker="${2:-}"; shift 2 ;;
      --subtitle) subtitle="${2:-}"; shift 2 ;;
      --duration) duration="${2:-}"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      --) shift; extras+=("$@"); break ;;
      -*) fail "unknown option: $1"; return 2 ;;
      *) extras+=("$1"); shift ;;
    esac
  done
  local title="${extras[*]}"
  [[ -n $title ]] || { fail "title required"; return 2; }
  if [[ $duration == 0 ]]; then
    warn "duration 0 stays until click / Escape / Super+W / hide — Super+W will not close Hermes"
  fi
  if [[ ! -f $DEST/manifest.json ]]; then
    install_plugin
  fi
  mkdir -p "$(dirname "$HOME/.local/state/omarchy/hermes-demo/scene.json")"
  python3 -c 'import json,sys
p={"kicker":sys.argv[1],"title":sys.argv[2],"subtitle":sys.argv[3],"duration":int(sys.argv[4])}
open(sys.argv[5],"w").write(json.dumps(p)+chr(10))
print(json.dumps(p, separators=(",", ":")))
' "$kicker" "$title" "$subtitle" "$duration" "$HOME/.local/state/omarchy/hermes-demo/scene.json" >/tmp/hermes-scene-payload.json
  local payload
  payload=$(cat /tmp/hermes-scene-payload.json)
  omarchy-shell shell summon "$ID" "$payload"
}

hide_card() {
  omarchy-shell shell hide "$ID"
}

action="${1:-}"
shift || true
case "$action" in
  install) install_plugin ;;
  remove) remove_plugin ;;
  check) check_plugin ;;
  show) show_card "$@" ;;
  hide) hide_card ;;
  -h|--help|"") usage; [[ -n $action ]] || exit 2 ;;
  *) echo "unknown argument: $action" >&2; usage; exit 2 ;;
esac
