#!/bin/bash
#
# hermes-omarchy-roll — auto-sting scene cards for camera beats
#
#   beat [--subtitle TEXT] [--duration MS] <title>
#   hide
#   preview   sting-only titles (no app launches, no theme change)
#
# Calls hermes-omarchy-scene. Default duration 4000. Never duration 0.
# Super+W / click / Escape still dismiss. Does not close Hermes.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SCENE="$SCRIPT_DIR/hermes-omarchy-scene"

ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$1" >&2; }

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

beat() {
  local subtitle="" duration="4000"
  local extras=()
  while (( $# > 0 )); do
    case "$1" in
      --subtitle) subtitle="${2:-}"; shift 2 ;;
      --duration) duration="${2:-}"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      --) shift; extras+=("$@"); break ;;
      -*) fail "unknown option: $1"; return 2 ;;
      *) extras+=("$1"); shift ;;
    esac
  done
  local title="${extras[*]}"
  [[ -n $title ]] || { fail "title required"; return 2; }
  if [[ $duration == 0 ]]; then
    duration=4000
    printf '  \033[33m!\033[0m duration 0 refused on roll; using 4000ms\n' >&2
  fi
  if [[ ! -x $SCENE ]]; then
    fail "missing $SCENE"
    return 1
  fi
  "$SCENE" check >/dev/null || "$SCENE" install
  if [[ -n $subtitle ]]; then
    "$SCENE" show "$title" --subtitle "$subtitle" --duration "$duration"
  else
    "$SCENE" show "$title" --duration "$duration"
  fi
}

hide() {
  "$SCENE" hide
}

preview() {
  # Titles only. Does not launch apps, change theme, or leave duration 0.
  local ms=2500
  beat --duration "$ms" --subtitle "Omarchy stays the OS" "Hermes on Omarchy"
  sleep 2.7
  beat --duration "$ms" --subtitle "full tile, bar stays" "Workspace 1 is the agent"
  sleep 2.7
  beat --duration "$ms" --subtitle "never beside Hermes" "Apps land on workspace 2+"
  sleep 2.7
  beat --duration "$ms" --subtitle "in the Hermes window" "HUD  Super+Shift+H"
  sleep 2.7
  hide || true
  ok "preview stings done"
}

action="${1:-}"
shift || true
case "$action" in
  beat) beat "$@" ;;
  hide) hide ;;
  preview) preview ;;
  -h|--help|"") usage; [[ -n $action ]] || exit 2 ;;
  *) echo "unknown argument: $action" >&2; usage; exit 2 ;;
esac
