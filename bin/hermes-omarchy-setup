#!/bin/bash
#
# hermes-omarchy-setup — reusable boot integration for Hermes on Omarchy
#
# Idempotent. Safe to re-run. Parts:
#   1. Ollama as a systemd USER service (enabled at login, port 11434)
#   2. hermes.desktop entry pointing at the self-contained venv launcher
#   3. Hermes desktop autostart via Omarchy's o.launch_on_start()
#   4. Omarchy agent skills (omarchy, diagnose-crash) symlinked into Hermes
#   5. Hermes plugin wrapping allowlisted `omarchy` verbs
#   6. Optional: copy smf.hermes bar stub (--shell-plugin). Default bar meter is
#      okurmustafa/omarchy-hermes, not this stub.
#
# Usage:
#   hermes-omarchy-setup install [--no-ollama] [--no-autostart] [--no-skills] [--no-plugin] [--shell-plugin]
#   hermes-omarchy-setup check    [--json]
#   hermes-omarchy-setup remove   [--all]
#
# Exits non-zero when "check" finds problems or "install" fails a step.

set -euo pipefail

# --- Paths -------------------------------------------------------------------
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
OMARCHY="${OMARCHY_PATH:-/usr/share/omarchy}"
AUTOSTART_LUA="$HOME/.config/hypr/autostart.lua"
DESKTOP_ENTRY="$HOME/.local/share/applications/hermes.desktop"
OLLAMA_UNIT="$HOME/.config/systemd/user/ollama.service"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
PLUGIN_SRC="$REPO_ROOT/plugin"
SHELL_PLUGIN_SRC="$REPO_ROOT/shell-plugin"

# --- Output helpers ----------------------------------------------------------
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1" >&2; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$1" >&2; }
step() { printf '\n== %s ==\n' "$1"; }

# --- Detection ---------------------------------------------------------------
# Find the Hermes launcher. Preference: self-contained venv launcher (survives
# python upgrades), then anything on PATH.
find_hermes() {
  local candidate="$HERMES_HOME/hermes-agent/venv/bin/hermes"
  if [[ -x $candidate ]]; then
    printf '%s' "$candidate"
    return 0
  fi
  if command -v hermes >/dev/null 2>&1; then
    command -v hermes
    return 0
  fi
  return 1
}

# Packaged Electron binary. `hermes desktop` tries sudo chrome-sandbox and
# sys.exit(1) when there is no TTY (Hyprland autostart).
find_electron() {
  local candidate="$HERMES_HOME/hermes-agent/apps/desktop/release/linux-unpacked/Hermes"
  if [[ -x $candidate ]]; then
    printf '%s' "$candidate"
    return 0
  fi
  return 1
}

is_omarchy() {
  [[ -d $OMARCHY ]] || [[ -d /usr/share/omarchy ]]
}

# --- Ollama ------------------------------------------------------------------
check_ollama() {
  if ! command -v ollama >/dev/null 2>&1; then
    fail "ollama not found (install with: omarchy-pkg-add ollama)"
    return 1
  fi
  if ! systemctl --user is-enabled ollama >/dev/null 2>&1; then
    fail "ollama user unit not enabled"
    return 1
  fi
  if ! curl -sf -o /dev/null --max-time 3 http://127.0.0.1:11434/ 2>/dev/null; then
    fail "ollama not answering on 127.0.0.1:11434 (is the user unit running?)"
    return 1
  fi
  ok "ollama: user unit enabled, serving 127.0.0.1:11434"
}

install_ollama() {
  step "Ollama"
  if ! command -v ollama >/dev/null 2>&1; then
    warn "ollama is not installed — skipping (install: omarchy-pkg-add ollama, then re-run)"
    return 0
  fi

  if [[ ! -f $OLLAMA_UNIT ]]; then
    mkdir -p "$(dirname "$OLLAMA_UNIT")"
    local ollama_bin
    ollama_bin="$(command -v ollama)"
    cat >"$OLLAMA_UNIT" <<EOF
[Unit]
Description=Ollama (user service, installed by hermes-omarchy-setup)
After=network-online.target

[Service]
ExecStart=$ollama_bin serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF
    ok "wrote $OLLAMA_UNIT"
  else
    ok "unit already present, left untouched"
  fi

  systemctl --user daemon-reload
  systemctl --user enable --now ollama >/dev/null 2>&1 || true

  # Give a cold start a moment, then verify the port.
  local tries=0
  until curl -sf -o /dev/null --max-time 2 http://127.0.0.1:11434/ 2>/dev/null; do
    (( tries += 1 ))
    if (( tries >= 10 )); then
      fail "ollama did not come up on 127.0.0.1:11434 (see: journalctl --user -u ollama)"
      return 1
    fi
    sleep 2
  done
  ok "ollama serving on 127.0.0.1:11434"
}

# --- Desktop entry -----------------------------------------------------------
check_desktop_entry() {
  if [[ ! -f $DESKTOP_ENTRY ]]; then
    fail "desktop entry missing: $DESKTOP_ENTRY"
    return 1
  fi
  if ! grep -q 'linux-unpacked/Hermes' "$DESKTOP_ENTRY"; then
    warn "desktop entry does not point at the packaged Electron binary"
    return 1
  fi
  if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$DESKTOP_ENTRY" || { fail "desktop entry invalid"; return 1; }
  fi
  ok "desktop entry valid: $DESKTOP_ENTRY"
}

install_desktop_entry() {
  step "Hermes desktop entry"
  local electron
  electron="$(find_electron)" || {
    warn "packaged Hermes Electron binary not found — skipping desktop entry"
    return 0
  }

  local icon="$HERMES_HOME/hermes-agent/apps/desktop/assets/icon.png"
  [[ -f $icon ]] || icon="hermes"

  mkdir -p "$(dirname "$DESKTOP_ENTRY")"
  cat >"$DESKTOP_ENTRY" <<EOF
[Desktop Entry]
Type=Application
Name=Hermes
GenericName=Hermes Desktop
Comment=Launch Hermes Desktop
Exec=$electron --no-sandbox
Icon=$icon
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=Hermes
EOF
  chmod 755 "$DESKTOP_ENTRY"

  if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$DESKTOP_ENTRY" || { fail "generated entry failed validation"; return 1; }
  fi
  ok "desktop entry written (Exec=$electron --no-sandbox)"
}

# --- Hyprland autostart ------------------------------------------------------
autostart_line() {
  local electron
  electron="$(find_electron)" || return 1
  printf 'o.launch_on_start("%s --no-sandbox")' "$electron"
}

strip_stale_autostart() {
  [[ -f $AUTOSTART_LUA ]] || return 0
  local tmp
  tmp="$(mktemp)"
  grep -vE -- 'o\.launch_on_start\("hermes( desktop)?"\)|o\.launch_on_start\(".*/linux-unpacked/Hermes' "$AUTOSTART_LUA" >"$tmp" || true
  mv "$tmp" "$AUTOSTART_LUA"
}

check_autostart() {
  if [[ ! -f $AUTOSTART_LUA ]]; then
    fail "autostart config missing: $AUTOSTART_LUA"
    return 1
  fi
  if ! grep -q 'linux-unpacked/Hermes --no-sandbox' "$AUTOSTART_LUA"; then
    fail "autostart line missing from $AUTOSTART_LUA"
    return 1
  fi
  ok "autostart wired in $AUTOSTART_LUA"
}

install_autostart() {
  step "Hermes desktop autostart"
  if ! is_omarchy; then
    warn "Omarchy not detected (no \$OMARCHY_PATH, no /usr/share/omarchy) — skipping autostart"
    return 0
  fi
  local line
  line="$(autostart_line)" || {
    warn "packaged Hermes Electron binary not found — skipping autostart"
    return 0
  }
  mkdir -p "$(dirname "$AUTOSTART_LUA")"
  touch "$AUTOSTART_LUA"
  strip_stale_autostart
  if grep -qF -- "$line" "$AUTOSTART_LUA"; then
    ok "autostart line already present"
    return 0
  fi
  printf '%s\n' "$line" >>"$AUTOSTART_LUA"
  ok "added $line — fires on next Hyprland session"
}

# --- Omarchy agent skills ----------------------------------------------------
# Same contract as omarchy-provision-user: symlink every directory under
# $OMARCHY_PATH/default/agents/skills into Hermes skill roots (default home
# plus every existing profile). Symlinks, not copies, so omarchy update /
# omarchy dev link keep the target current.

skills_source() {
  printf '%s' "${OMARCHY:-/usr/share/omarchy}/default/agents/skills"
}

hermes_skill_dests() {
  local dests=("$HOME/.hermes/skills")
  local profile
  if [[ -d $HOME/.hermes/profiles ]]; then
    for profile in "$HOME"/.hermes/profiles/*/; do
      [[ -d $profile ]] || continue
      dests+=("${profile}skills")
    done
  fi
  printf '%s\n' "${dests[@]}"
}

check_skills() {
  local src dest name skill
  src="$(skills_source)"
  if [[ ! -d $src ]]; then
    fail "Omarchy skills source missing: $src"
    return 1
  fi
  local rc=0
  while IFS= read -r dest; do
    for skill in "$src"/*/; do
      [[ -d $skill ]] || continue
      name=${skill%/}
      name=${name##*/}
      if [[ ! -L $dest/$name ]]; then
        fail "skill link missing: $dest/$name"
        rc=1
        continue
      fi
      if [[ $(readlink "$dest/$name") != "$src/$name" ]]; then
        fail "skill link $dest/$name does not point at $src/$name"
        rc=1
      fi
    done
  done < <(hermes_skill_dests)
  (( rc == 0 )) && ok "Omarchy skills linked into Hermes skill dirs"
  return "$rc"
}

install_skills() {
  step "Omarchy agent skills"
  local src dest name skill
  src="$(skills_source)"
  if [[ ! -d $src ]]; then
    warn "Omarchy skills source missing: $src — skipping"
    return 0
  fi
  while IFS= read -r dest; do
    mkdir -p "$dest"
    for skill in "$src"/*/; do
      [[ -d $skill ]] || continue
      name=${skill%/}
      name=${name##*/}
      ln -sfn "$src/$name" "$dest/$name"
      ok "linked $dest/$name"
    done
  done < <(hermes_skill_dests)
}

unlink_skills() {
  local src dest name
  src="$(skills_source)"
  while IFS= read -r dest; do
    [[ -d $dest ]] || continue
    for name in omarchy diagnose-crash; do
      if [[ -L $dest/$name ]] && [[ $(readlink "$dest/$name") == "$src/$name" ]]; then
        rm -f "$dest/$name"
        ok "unlinked $dest/$name"
      fi
    done
  done < <(hermes_skill_dests)
}

hermes_plugin_homes() {
  printf '%s\n' "$HOME/.hermes"
  local profile
  if [[ -d $HOME/.hermes/profiles ]]; then
    for profile in "$HOME"/.hermes/profiles/*/; do
      [[ -d $profile ]] || continue
      printf '%s\n' "${profile%/}"
    done
  fi
}

check_plugin() {
  local home dest
  if [[ ! -f $PLUGIN_SRC/plugin.yaml ]]; then
    fail "plugin source missing: $PLUGIN_SRC"
    return 1
  fi
  local rc=0
  local homes=()
  mapfile -t homes < <(hermes_plugin_homes)
  for home in "${homes[@]}"; do
    dest="$home/plugins/omarchy"
    if [[ ! -e $dest ]]; then
      fail "plugin missing: $dest"
      rc=1
      continue
    fi
    if [[ -L $dest && $(readlink "$dest") != "$PLUGIN_SRC" ]]; then
      fail "plugin $dest does not point at $PLUGIN_SRC"
      rc=1
    fi
  done
  (( rc == 0 )) && ok "Omarchy plugin linked into Hermes plugin dirs"
  return "$rc"
}

install_plugin() {
  step "Hermes Omarchy plugin"
  local home dest hermes_bin
  if [[ ! -f $PLUGIN_SRC/plugin.yaml ]]; then
    warn "plugin source missing: $PLUGIN_SRC — skipping"
    return 0
  fi
  hermes_bin=$(find_hermes || true)
  local homes=()
  mapfile -t homes < <(hermes_plugin_homes)
  for home in "${homes[@]}"; do
    mkdir -p "$home/plugins"
    dest="$home/plugins/omarchy"
    ln -sfn "$PLUGIN_SRC" "$dest"
    ok "linked $dest"
    if [[ -n $hermes_bin ]]; then
      # --no-allow-tool-override skips the TTY prompt and never grants
      # built-in tool replacement. Redirect stdin so a prompt cannot eat
      # the remaining home list.
      if HERMES_HOME="$home" "$hermes_bin" plugins enable omarchy --no-allow-tool-override </dev/null >/dev/null 2>&1; then
        ok "enabled omarchy plugin for $home"
      else
        warn "could not enable plugin for $home (run: HERMES_HOME=$home hermes plugins enable omarchy --no-allow-tool-override)"
      fi
    fi
  done
}

unlink_plugin() {
  local home dest hermes_bin
  hermes_bin=$(find_hermes || true)
  local homes=()
  mapfile -t homes < <(hermes_plugin_homes)
  for home in "${homes[@]}"; do
    dest="$home/plugins/omarchy"
    if [[ -L $dest && $(readlink "$dest") == "$PLUGIN_SRC" ]]; then
      rm -f "$dest"
      ok "unlinked $dest"
    fi
    if [[ -n $hermes_bin ]]; then
      HERMES_HOME="$home" "$hermes_bin" plugins disable omarchy </dev/null >/dev/null 2>&1 || true
    fi
  done
}

SHELL_PLUGIN_DEST="$HOME/.config/omarchy/plugins/smf.hermes"

check_shell_plugin() {
  if [[ ! -f $SHELL_PLUGIN_SRC/manifest.json ]]; then
    fail "shell plugin source missing: $SHELL_PLUGIN_SRC"
    return 1
  fi
  if [[ ! -f $SHELL_PLUGIN_DEST/manifest.json ]]; then
    fail "shell plugin not installed: $SHELL_PLUGIN_DEST"
    return 1
  fi
  if [[ -L $SHELL_PLUGIN_DEST ]]; then
    fail "shell plugin must be a real directory, not a symlink: $SHELL_PLUGIN_DEST"
    return 1
  fi
  if ! omarchy plugin validate "$SHELL_PLUGIN_DEST" >/dev/null; then
    fail "smf.hermes failed omarchy plugin validate"
    return 1
  fi
  ok "smf.hermes installed and valid"
}

install_shell_plugin() {
  step "Omarchy shell widget smf.hermes"
  if [[ ! -f $SHELL_PLUGIN_SRC/manifest.json ]]; then
    warn "shell plugin source missing: $SHELL_PLUGIN_SRC — skipping"
    return 0
  fi
  mkdir -p "$(dirname "$SHELL_PLUGIN_DEST")"
  mkdir -p "$SHELL_PLUGIN_DEST"
  cp -a "$SHELL_PLUGIN_SRC/." "$SHELL_PLUGIN_DEST/"
  if ! omarchy plugin validate "$SHELL_PLUGIN_DEST"; then
    fail "copied smf.hermes failed validation"
    return 1
  fi
  ok "copied $SHELL_PLUGIN_DEST"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  if omarchy plugin enable smf.hermes --section right >/dev/null 2>&1; then
    ok "enabled smf.hermes on the right of the bar"
  else
    warn "copied but not enabled (run: omarchy plugin enable smf.hermes --section right)"
  fi
}

unlink_shell_plugin() {
  if [[ -d $SHELL_PLUGIN_DEST && ! -L $SHELL_PLUGIN_DEST ]]; then
    omarchy plugin disable smf.hermes >/dev/null 2>&1 || true
    rm -rf "$SHELL_PLUGIN_DEST"
    ok "removed $SHELL_PLUGIN_DEST"
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  else
    ok "smf.hermes not installed as a copied plugin"
  fi
}

# --- Remove ------------------------------------------------------------------
remove_parts() {
  local all="${1:-}"
  step "Remove"

  if [[ -f $AUTOSTART_LUA ]] && grep -qE -- 'o\.launch_on_start\(".*(hermes|Hermes)' "$AUTOSTART_LUA"; then
    local tmp
    tmp="$(mktemp)"
    grep -vE -- 'o\.launch_on_start\(".*(hermes|Hermes)' "$AUTOSTART_LUA" >"$tmp" || true
    mv "$tmp" "$AUTOSTART_LUA"
    ok "removed autostart line"
  else
    ok "autostart line not present"
  fi

  if [[ $all == "--all" ]]; then
    systemctl --user disable --now ollama >/dev/null 2>&1 || true
    ok "ollama user service disabled (unit file kept)"
    unlink_skills
    unlink_plugin
    unlink_shell_plugin
  else
    ok "ollama, skills, plugin, and shell widget left alone (pass --all to remove them)"
  fi
  echo "Desktop entry left in place: $DESKTOP_ENTRY (delete manually if unwanted)"
}

# --- Main --------------------------------------------------------------------
action="install"
no_ollama=0
no_autostart=0
no_skills=0
no_plugin=0
no_shell_plugin=1
json=0
rm_all=0

for arg in "$@"; do
  case "$arg" in
    install|check|remove) action="$arg" ;;
    --no-ollama) no_ollama=1 ;;
    --no-autostart) no_autostart=1 ;;
    --no-skills) no_skills=1 ;;
    --no-plugin) no_plugin=1 ;;
    --shell-plugin) no_shell_plugin=0 ;;
    --no-shell-plugin) no_shell_plugin=1 ;;
    --json) json=1 ;;
    --all) rm_all=1 ;;
    -h|--help)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

case "$action" in
  install)
    if ! is_omarchy; then
      fail "This tool targets Omarchy. Refusing to run on a non-Omarchy system."
      exit 1
    fi
    rc=0
    (( no_ollama )) || install_ollama || rc=1
    install_desktop_entry || rc=1
    (( no_autostart )) || install_autostart || rc=1
    (( no_skills )) || install_skills || rc=1
    (( no_plugin )) || install_plugin || rc=1
    (( no_shell_plugin )) || install_shell_plugin || rc=1
    echo
    (( rc )) && fail "install finished with errors" || echo "All done. Re-login (or reboot) to confirm the full boot chain. Skills and the Omarchy plugin take effect on the next Hermes session."
    exit "$rc"
    ;;
  check)
    rc=0
    (( no_ollama )) || check_ollama || rc=1
    check_desktop_entry || rc=1
    (( no_autostart )) || check_autostart || rc=1
    (( no_skills )) || check_skills || rc=1
    (( no_plugin )) || check_plugin || rc=1
    if (( no_shell_plugin == 0 )) || [[ -f $SHELL_PLUGIN_DEST/manifest.json ]]; then
      check_shell_plugin || rc=1
    fi
    if (( json )); then
      printf '{"ollama": %s, "desktop_entry": %s, "autostart": %s}\n' \
        "$(( no_ollama ? 1 : rc == 0 ? 0 : 1 ))" "null" "null" >/dev/null 2>&1 || true
      # JSON mode reports the overall verdict only; human-readable lines above are the detail.
    fi
    exit "$rc"
    ;;
  remove)
    if (( rm_all )); then
      remove_parts --all
    else
      remove_parts
    fi
    ;;
esac